# Required by Prisma, the app, and Postgres-backed route/browser tests.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fusion_manaba?schema=public"

# Optional. Leave unset for normal development and deployment.
# Set to false only when a local or CI production-mode E2E server uses HTTP.
# Vercel deployments always keep the cart cookie Secure.
# CART_COOKIE_SECURE=false
